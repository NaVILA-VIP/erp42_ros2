<launch>
  <node pkg="erp42_control" exec="noisy_odom.py" output="screen">
    <param name="use_sim_time" value="true"/>
  </node>
  <node pkg="robot_localization" exec="ekf_node" name="ekf_localization" output="screen">
    <param from="$(find-pkg-share odometry_localization)/config/ekf_localization.yaml"/>
